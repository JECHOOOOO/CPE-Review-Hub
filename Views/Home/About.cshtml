@{ ViewData["Title"] = "About COLMS"; ViewData["BodyClass"] = "about-page"; }
<section class="about-hero" aria-labelledby="about-title">
    <span class="eyebrow">A COMPUTER ENGINEERING LEARNING PLATFORM</span>
    <h1 id="about-title">About COLMS</h1>
    <p class="about-subtitle">CentOs Learning Management System</p>
    <p class="lead">COLMS is a learning platform developed by CentOs, a student development team committed to creating an organized and accessible digital learning environment for Computer Engineering students. It brings lessons, learning activities, quizzes, examinations, and progress tracking together in one structured place.</p>
</section>

<section class="centos-purpose" aria-labelledby="centos-purpose-title">
    <span class="centos-wordmark">CentOs</span>
    <p class="eyebrow">THE MEANING BEHIND THE NAME</p>
    <h2 id="centos-purpose-title" aria-label="CENTERED ON SUCCESS"><span>CENTERED ON</span><span>SUCCESS</span></h2>
    <p>The idea behind the team. The principle behind COLMS.</p>
    <p class="centos-purpose-detail">The name reflects the team's goal of keeping learning, progress, and student development at the center of the COLMS experience.</p>
</section>

<section class="about-purpose-grid" aria-label="About COLMS">
    <article>
        <span class="eyebrow">OUR STORY</span>
        <h2>Built around engineering learning</h2>
        <p>CentOs developed COLMS to help Computer Engineering students review course material, practice what they learn, assess their understanding, and follow their academic progress.</p>
    </article>
    <article>
        <span class="eyebrow">WHAT COLMS PROVIDES</span>
        <h2>A structured study path</h2>
        <ul class="about-feature-list">
            <li>Organized Computer Engineering courses and lessons</li>
            <li>Lesson activities for practice</li>
            <li>Automatically scored quizzes and examinations</li>
            <li>Student progress and results tracking</li>
            <li>Academic resources and lesson visuals</li>
        </ul>
    </article>
</section>

