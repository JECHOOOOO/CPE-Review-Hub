@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Admin · COLMS: CentOs Learning Management System</title>
    <link rel="icon" type="image/png" href="~/images/brand/colms-emblem.png" />
    <link rel="stylesheet" href="~/css/hub.css" asp-append-version="true" />
</head>
<body class="portal-body admin-theme admin-portal">
    <a class="skip-link" href="#main">Skip to content</a>
    <aside class="sidebar liquid-glass">
        <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-label="COLMS Admin portal"><img class="brand-logo portal-brand-logo" src="~/images/brand/colms-emblem.png" alt="" /><span>COLMS<small>CentOs Learning Management System</small><small class="portal-label">ADMIN PORTAL</small></span></a>
        <p class="nav-caption">ADMINISTRATION</p>
        <nav aria-label="Admin navigation">
            <a class="nav-item @(controller == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="nav-item @(controller == "Students" ? "active" : "")" asp-area="Admin" asp-controller="Students" asp-action="Index">Manage students</a>
            <a class="nav-item @(controller == "Subjects" ? "active" : "")" asp-area="Admin" asp-controller="Subjects" asp-action="Index">Manage subjects</a>
            <a class="nav-item @(controller == "Lessons" ? "active" : "")" asp-area="Admin" asp-controller="Lessons" asp-action="Index">Manage lessons</a>
            <a class="nav-item @(controller == "Materials" ? "active" : "")" asp-area="Admin" asp-controller="Materials" asp-action="Index">Review materials</a>
            <a class="nav-item @(controller == "LessonImages" ? "active" : "")" asp-area="Admin" asp-controller="LessonImages" asp-action="Index">Lesson images</a>
            <a class="nav-item @(controller is "Assessments" or "Questions" && Context.Request.Query["type"] != "FinalExam" ? "active" : "")" asp-area="Admin" asp-controller="Assessments" asp-action="Index" asp-route-type="LessonQuiz">Questions &amp; quizzes</a>
            <a class="nav-item @(controller == "Assessments" && Context.Request.Query["type"] == "FinalExam" ? "active" : "")" asp-area="Admin" asp-controller="Assessments" asp-action="Index" asp-route-type="FinalExam">Final exams</a>
            <a class="nav-item @(controller == "Results" ? "active" : "")" asp-area="Admin" asp-controller="Results" asp-action="Index">Student results</a>
            <a class="nav-item @(controller == "ActivitySubmissions" ? "active" : "")" asp-area="Admin" asp-controller="ActivitySubmissions" asp-action="Index">Activity submissions</a>
            <a class="nav-item @(controller == "Statistics" ? "active" : "")" asp-area="Admin" asp-controller="Statistics" asp-action="Index">Statistics</a>
        </nav>
        <div class="sidebar-bottom"><p>Signed in as<br /><strong>@User.Identity?.Name</strong></p>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post"><button class="button secondary full" type="submit">Log out</button></form>
        </div>
    </aside>
    <div class="portal-content">
        <header class="portal-header liquid-glass"><span>Administration workspace</span><span class="badge">Admin account</span></header>
        <main id="main" class="dashboard-main">
            @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
            @if (TempData["Error"] is string error) { <div class="notice" role="alert">@error</div> }
            @RenderBody()
        </main>
        <footer class="site-footer">COLMS: CentOs Learning Management System · Administration.</footer>
    </div>
</body>
</html>
