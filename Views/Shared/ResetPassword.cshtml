@model PasswordResetViewModel
@{ Layout = "_SiteLayout"; var portal = ViewData["PortalName"]?.ToString() ?? "student"; var actionPath = ViewData["FormAction"]?.ToString() ?? "/student/reset-password"; ViewData["Title"] = "Reset password"; ViewData["BodyClass"] = "auth-page login-page"; }
<section class="auth-card reset-card">
    <span class="eyebrow">SECURE ACCOUNT RECOVERY</span><h1>Choose a new password</h1><p>Reset the password for your @portal account.</p>
    <form action="@actionPath" method="post" asp-antiforgery="true">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
        <label asp-for="Password"></label><div class="password-field"><input asp-for="Password" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div>
        <label asp-for="ConfirmPassword"></label><div class="password-field"><input asp-for="ConfirmPassword" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle="ConfirmPassword" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7S18.4 19 12 19 2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div>
        <button class="button full" type="submit">Update password</button>
    </form>
    <p class="form-foot"><a href="@(portal == "administrator" ? "/admin.html" : "/student.html")">Back to sign in</a></p>
</section>
