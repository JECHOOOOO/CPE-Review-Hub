<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · COLMS: CentOs Learning Management System</title>
    <link rel="icon" type="image/png" href="~/images/brand/colms-emblem.png" />
    <link rel="stylesheet" href="~/css/hub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-transitions.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    @if (ViewData["BodyClass"]?.ToString()?.Split(' ').Contains("auth-page") == true)
    {
        <div class="auth-video-background" aria-hidden="true"><partial name="_JourneyVideo" model='@("auth-video")' /></div>
    }
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header liquid-glass">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="COLMS home"><img class="brand-logo" src="~/images/brand/colms-emblem.png" alt="" /><span>COLMS<small>CentOs Learning Management System</small></span></a>
        <nav aria-label="Public navigation">@if (ViewData["BodyClass"]?.ToString() == "landing-page") { <span class="landing-nav-links"><a href="/">Home</a><a href="/about">About COLMS</a><a href="/#learning">Learning</a></span> }<a href="/student.html">Student login</a><a class="nav-journey liquid-glass" asp-area="Student" asp-controller="Account" asp-action="Register">Begin journey</a></nav>
    </header>
    <main id="main" class="public-main">
        @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>© @DateTime.UtcNow.Year COLMS: CentOs Learning Management System · Developed by BS Computer Engineering Students</span><nav class="footer-links" aria-label="Footer"><a href="/about">About COLMS</a><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></nav>
        @if (ViewData["BodyClass"]?.ToString()?.Split(' ').Contains("auth-page") == true)
        {
            <button type="button" class="background-playback" data-background-playback hidden>Pause background</button>
        }
    </footer>
    <script src="~/js/ambient-video.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
