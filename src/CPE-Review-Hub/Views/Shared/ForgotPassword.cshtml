@model PasswordResetRequestViewModel
@{ Layout = "_SiteLayout"; var portal = ViewData["PortalName"]?.ToString() ?? "student"; var actionPath = ViewData["FormAction"]?.ToString() ?? "/student/forgot-password"; ViewData["Title"] = "Forgot password"; ViewData["BodyClass"] = "auth-page login-page"; }
<section class="auth-card reset-card">
    <span class="eyebrow">ACCOUNT RECOVERY</span><h1>Forgot password?</h1>
    <p>Enter the email address for your @portal account. If an account exists, we’ll send a password reset link.</p>
    @if (TempData["PasswordResetNotice"] is string notice) { <div class="notice success" role="status">@notice</div> }
    <form action="@actionPath" method="post" asp-antiforgery="true">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" required />
        <button class="button full" type="submit">Send reset instructions</button>
    </form>
    <p class="form-foot"><a href="@(portal == "administrator" ? "/admin.html" : "/student.html")">Back to sign in</a> · <a href="/about">About COLMS</a></p>
</section>
