@model StudentProgressViewModel
@{ ViewData["Title"] = "My progress"; }
<span class="eyebrow">LEARNING RECORD</span><h1>My scores and progress</h1><p class="lead">Activities and submitted assessments are saved to your Student account.</p>
<div class="progress-course-list">@foreach (var course in Model.Courses) { <article class="panel progress-course"><div><span class="eyebrow">@course.Code</span><h2>@course.Title</h2><p>@course.CompletedActivities/@course.LessonCount activities · @course.CompletedQuizzes/@course.LessonCount lesson quizzes @if (course.BestFinalPercentage is not null) { <span> · Final @course.BestFinalPercentage.Value.ToString("0.##")%</span> }</p></div><div class="progress-value"><strong>@course.ProgressPercentage%</strong><div class="progress-track"><span style="width:@course.ProgressPercentage%"></span></div><a asp-area="Student" asp-controller="Subjects" asp-action="Details" asp-route-id="@course.SubjectId">Continue course →</a></div></article> }</div>
<div class="section-heading"><h2>Quiz and exam history</h2><span class="muted small">@Model.History.Count submitted attempt(s)</span></div>
@if (Model.History.Count == 0) { <section class="panel empty-state"><h2>No scores yet</h2><p>Complete a lesson activity and take its quiz to begin your history.</p></section> }
else { <div class="table-wrap"><table><thead><tr><th>Date</th><th>Course</th><th>Assessment</th><th>Score</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var row in Model.History) { <tr><td>@row.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td>@row.CourseCode</td><td>@row.Title<br /><span class="muted small">@row.Type</span></td><td>@row.Score/@row.Total (@row.Percentage.ToString("0.##")%)</td><td><span class="badge">@(row.IsPassed ? "Passed" : "Review")</span></td><td><a asp-area="Student" asp-controller="Assessments" asp-action="Result" asp-route-attemptId="@row.AttemptId">Review</a></td></tr> }</tbody></table></div> }
