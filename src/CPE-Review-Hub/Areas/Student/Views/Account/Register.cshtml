@model RegisterViewModel
@{ Layout = "_SiteLayout"; ViewData["Title"] = "Create student account"; ViewData["BodyClass"] = "auth-page student-auth-page login-page"; }
<section class="auth-card register-card">
    <span class="eyebrow">STUDENT REGISTRATION</span><h1>Start your review journey</h1><p>Create your student account to start learning. We'll send a welcome email when your account is ready.</p>
    <form asp-area="Student" asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" required />
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" required />
        <div class="form-row"><div><label asp-for="University"></label><input asp-for="University" autocomplete="organization" /></div><div><label asp-for="YearLevel"></label><select asp-for="YearLevel"><option value="">Select year</option><option>1st Year</option><option>2nd Year</option><option>3rd Year</option><option>4th Year</option><option>Graduate / Reviewer</option></select></div></div>
        <label asp-for="Password"></label><div class="password-field"><input asp-for="Password" autocomplete="new-password" minlength="8" aria-describedby="password-help" required /><button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div>
        <p id="password-help" class="small muted">At least 8 characters. Uppercase letters, numbers, and symbols are optional.</p>
        <label asp-for="ConfirmPassword"></label><div class="password-field"><input asp-for="ConfirmPassword" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle="ConfirmPassword" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7S18.4 19 12 19 2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div>
        <button type="submit" class="button full">Create student account</button>
    </form>
    <p class="form-foot">Already registered? <a href="/student.html">Sign in</a></p>
    <p class="form-foot about-form-link"><a href="/about">About COLMS</a></p>
</section>
