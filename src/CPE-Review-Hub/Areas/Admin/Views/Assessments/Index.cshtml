@model IReadOnlyList<CPE_Review_Hub.ViewModels.AssessmentAdminRow>
@using CPE_Review_Hub.Models
@{ var type = (AssessmentType)(ViewData["Type"] ?? AssessmentType.LessonQuiz); ViewData["Title"] = type == AssessmentType.FinalExam ? "Final exams" : "Questions and quizzes"; }
<div class="page-heading"><div><span class="eyebrow">ASSESSMENT MANAGEMENT</span><h1>@ViewData["Title"]</h1><p class="lead">Edit settings and maintain course-specific questions stored in MySQL.</p></div></div>
<div class="tab-links"><a class="@(type == AssessmentType.LessonQuiz ? "active" : "")" asp-route-type="LessonQuiz">Lesson quizzes</a><a class="@(type == AssessmentType.FinalExam ? "active" : "")" asp-route-type="FinalExam">Final exams</a></div>
<section class="panel">
@if (Model.Count == 0) { <div class="empty-state"><h2>No assessments found</h2></div> }
else { <div class="table-scroll"><table><thead><tr><th>Course</th><th>Assessment</th><th>Questions</th><th>Pass</th><th>Attempts</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.SubjectCode</strong><br /><span class="muted small">@item.LessonTitle</span></td><td>@item.Title</td><td>@item.CurrentQuestions / @item.RequiredQuestions</td><td>@item.PassingPercentage%</td><td>@item.AttemptCount</td><td><span class="badge">@(item.IsPublished ? "Published" : "Draft")</span></td><td class="table-actions"><a asp-action="Details" asp-route-id="@item.Id">Questions</a><a asp-action="Edit" asp-route-id="@item.Id">Settings</a></td></tr> }
</tbody></table></div> }
</section>
