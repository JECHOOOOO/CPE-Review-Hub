@model CPE_Review_Hub.ViewModels.AssessmentAdminDetailsViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="page-heading"><div><span class="eyebrow">@Model.SubjectCode · @(Model.Type == CPE_Review_Hub.Models.AssessmentType.FinalExam ? "FINAL EXAM" : Model.LessonTitle)</span><h1>@Model.Title</h1><p class="lead">@Model.Questions.Count active and inactive questions · requires @Model.RequiredQuestions · passing @Model.PassingPercentage% · @Model.DurationMinutes minutes</p></div><div class="button-row"><a class="button secondary" asp-action="Edit" asp-route-id="@Model.Id">Settings</a><a class="button" asp-area="Admin" asp-controller="Questions" asp-action="Create" asp-route-assessmentId="@Model.Id">Add question</a></div></div>
<section class="panel">
@if (Model.Questions.Count == 0) { <div class="empty-state"><h2>No questions yet</h2><p>Add questions before publishing this assessment.</p></div> }
else { <div class="admin-question-list">@foreach (var q in Model.Questions) { <article class="admin-question-card"><div class="question-card-head"><span class="badge">Question @q.Number</span><span class="small muted">@(q.IsActive ? "Active" : "Inactive") · @q.ChoiceCount choices · used in @q.AttemptAnswerCount answers</span></div><h2>@q.Prompt</h2><p class="correct-answer"><strong>Correct:</strong> @q.CorrectAnswer</p><div class="table-actions"><a asp-area="Admin" asp-controller="Questions" asp-action="Edit" asp-route-id="@q.Id" asp-route-assessmentId="@Model.Id">Edit</a><a class="danger-link" asp-area="Admin" asp-controller="Questions" asp-action="Delete" asp-route-id="@q.Id" asp-route-assessmentId="@Model.Id">Remove</a></div></article> }</div> }
</section>
