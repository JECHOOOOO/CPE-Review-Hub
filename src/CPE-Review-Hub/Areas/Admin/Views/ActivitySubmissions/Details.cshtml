@model CPE_Review_Hub.ViewModels.AdminActivitySubmissionViewModel
@{ ViewData["Title"] = "Activity participation"; }
<a asp-action="Index">← Student activities</a>
<div class="page-heading">
    <div><span class="eyebrow">@Model.SubjectCode · @Model.LessonTitle</span><h1>@Model.StudentName</h1><p class="lead">@Model.StudentEmail</p></div>
    <span class="status-complete">Completed</span>
</div>
<dl class="activity-metadata panel">
    <div><dt>Course</dt><dd>@Model.SubjectCode</dd></div>
    <div><dt>Lesson</dt><dd>@Model.LessonTitle</dd></div>
    <div><dt>Activity</dt><dd>@Model.ActivityTitle</dd></div>
    <div><dt>Completion status</dt><dd>Completed</dd></div>
    <div><dt>Completed</dt><dd>@Model.CompletedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd></div>
    @if (Model.UpdatedAtUtc != Model.CompletedAtUtc) { <div><dt>Last response update</dt><dd>@Model.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd></div> }
</dl>
<section class="panel">
    <span class="eyebrow">READ-ONLY PARTICIPATION RECORD</span>
    <h2>@Model.ActivityTitle</h2>
    <details><summary>Activity instructions and expected output</summary><div class="material-content">@Model.Instructions</div><strong>Expected output</strong><div class="material-content">@Model.ExpectedOutput</div></details>
    <h3>Student response</h3><div class="submission-response">@Model.Response</div>
    <h3>Submitted files</h3>
    @if (Model.Attachments.Count == 0) { <p class="muted">No files attached.</p> }
    @foreach (var file in Model.Attachments)
    {
        <article class="submission-file">
            @if (file.ContentType is "image/png" or "image/jpeg" or "image/webp")
            {
                <a asp-action="Preview" asp-route-id="@file.Id" target="_blank" rel="noopener"><img class="submission-image" src="@Url.Action("Preview", new { id = file.Id })" alt="Student attachment: @file.FileName" loading="lazy" /></a>
            }
            <div class="attachment-row"><a asp-action="Download" asp-route-id="@file.Id">Download @file.FileName</a><span class="small muted">@((file.FileSize / 1024d).ToString("0.#")) KB</span></div>
        </article>
    }
    <div class="notice activity-readonly-note"><strong>Monitoring only</strong><br />This icebreaker activity is not graded. Quiz and exam results are calculated automatically.</div>
</section>
