@model CPE_Review_Hub.ViewModels.ActivitySubmissionIndexViewModel
@{ ViewData["Title"] = "Activity participation"; }
<span class="eyebrow">PARTICIPATION MONITORING</span>
<h1>Student activities</h1>
<p class="lead">View completed icebreaker activities and student responses. Activities are practice work and are never graded.</p>
<form method="get" class="panel activity-filters">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <div class="activity-filter-grid">
        <label>Student<input name="student" value="@Model.Student" maxlength="120" placeholder="Name or email" /></label>
        <label>Course<select name="courseId"><option value="">All courses</option>@foreach (var option in Model.Courses) { <option value="@option.Id" selected="@(Model.CourseId == option.Id)">@option.Label</option> }</select></label>
        <label>Lesson<select name="lessonId"><option value="">All lessons</option>@foreach (var option in Model.Lessons) { <option value="@option.Id" selected="@(Model.LessonId == option.Id)">@option.Label</option> }</select></label>
        <label>From date<input name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></label>
        <label>To date<input name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></label>
    </div>
    <div class="button-row"><button class="button" type="submit">Apply filters</button><a class="button secondary" asp-action="Index">Clear</a></div>
</form>
@if (Model.Submissions.Count == 0)
{
    <section class="panel empty-state"><h2>No matching activity completions</h2><p>Submitted student activities will appear here.</p></section>
}
else
{
    <section class="panel table-scroll">
        <table>
            <thead><tr><th>Student</th><th>Course</th><th>Lesson</th><th>Activity</th><th>Status</th><th>Completed at</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var submission in Model.Submissions)
            {
                <tr>
                    <td><strong>@submission.StudentName</strong><br /><span class="small muted">@submission.StudentEmail</span></td>
                    <td><strong>@submission.SubjectCode</strong></td>
                    <td>@submission.LessonTitle</td>
                    <td>@submission.ActivityTitle@if (submission.AttachmentCount > 0) { <br /><span class="small muted">@submission.AttachmentCount file(s)</span> }</td>
                    <td><span class="status-complete">Completed</span></td>
                    <td>@submission.CompletedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                    <td><a asp-action="Details" asp-route-id="@submission.Id">View →</a></td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
<nav class="button-row" aria-label="Submission pages">
    @if (Model.Page > 1) { <a class="button secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-student="@Model.Student" asp-route-courseId="@Model.CourseId" asp-route-lessonId="@Model.LessonId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Previous</a> }
    <span>Page @Model.Page</span>
    @if (Model.HasNextPage) { <a class="button secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-student="@Model.Student" asp-route-courseId="@Model.CourseId" asp-route-lessonId="@Model.LessonId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Next</a> }
</nav>
