@model LessonImage
@{ ViewData["Title"] = "Remove lesson image"; }
<span class="eyebrow">CONTENT MANAGEMENT</span><h1>Remove lesson image</h1><section class="panel form-panel"><p>Remove the image reference for <strong>@Model.Lesson.Subject.Code · @Model.Lesson.Title</strong>?</p><img class="lesson-image-preview" src="@Model.ImagePath" alt="@Model.AltText" loading="lazy" referrerpolicy="no-referrer" onerror="this.hidden=true" /><p class="muted">This removes only the COLMS database association. No external image file is downloaded or deleted.</p><form method="post"><button class="button danger" type="submit">Remove image</button> <a class="button secondary" asp-action="Index">Cancel</a></form></section>
