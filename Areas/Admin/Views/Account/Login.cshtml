@model LoginViewModel
@{ Layout = "_SiteLayout"; ViewData["Title"] = "Admin login"; ViewData["BodyClass"] = "auth-page admin-auth-page login-page"; }
<div class="auth-grid admin-theme">
    <section class="auth-intro"><span class="eyebrow">ADMINISTRATOR PORTAL</span><h1>Support every<br />student's journey.</h1><p>A separate workspace for authorized COLMS: CentOs Learning Management System administrators.</p><div class="intro-note"><strong>Restricted access</strong><p>Student accounts cannot sign in to this portal. Admin accounts are provisioned by the system operator.</p></div></section>
    <section class="auth-card"><span class="badge">Authorized administrators only</span><h2>Admin sign in</h2><p>Use your administrator account to continue.</p>
        <form action="/admin.html" method="post" asp-antiforgery="true">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label asp-for="Email"></label><input asp-for="Email" autocomplete="username" required />
            <label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" required />
            <button type="submit" class="button full">Sign in to admin portal →</button>
        </form>
        <p class="form-foot">Studying here? <a href="/student.html">Go to student login</a></p>
        <p class="muted small">There is no public administrator registration.</p>
    </section>
</div>
