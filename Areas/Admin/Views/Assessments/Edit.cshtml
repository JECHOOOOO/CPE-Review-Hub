@model CPE_Review_Hub.ViewModels.AssessmentSettingsViewModel
@{ ViewData["Title"] = "Assessment settings"; }
<span class="eyebrow">@Model.ContextLabel</span><h1>Assessment settings</h1><p class="lead">Control availability, passing score, and required question count.</p>
<section class="panel form-panel"><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Title"></label><input asp-for="Title" /><span asp-validation-for="Title"></span><div class="form-grid"><div><label asp-for="RequiredQuestionCount"></label><input asp-for="RequiredQuestionCount" /><span asp-validation-for="RequiredQuestionCount"></span></div><div><label asp-for="DurationMinutes"></label><input asp-for="DurationMinutes" /><span asp-validation-for="DurationMinutes"></span></div><div><label asp-for="PassingPercentage"></label><input asp-for="PassingPercentage" /><span asp-validation-for="PassingPercentage"></span></div></div><p class="small muted">Currently @Model.CurrentQuestionCount active questions.</p><label class="check-row"><input asp-for="IsPublished" /> <span>Published to students</span></label><span asp-validation-for="IsPublished"></span><div class="button-row"><button class="button" type="submit">Save settings</button><a class="button secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div></form></section>
