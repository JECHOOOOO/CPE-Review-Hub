@model CPE_Review_Hub.ViewModels.QuestionFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add question" : "Edit question"; }
<span class="eyebrow">@Model.AssessmentLabel</span><h1>@ViewData["Title"]</h1><p class="lead">Keep the question and feedback clear, concise, and based on the selected lesson.</p>
<section class="panel form-panel"><form asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><input asp-for="AssessmentId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<label asp-for="LessonId"></label>@if (Model.AssessmentType == CPE_Review_Hub.Models.AssessmentType.LessonQuiz) { <input asp-for="LessonId" type="hidden" /><p class="readonly-value">@Model.Lessons.FirstOrDefault(x => x.Id == Model.LessonId)?.Label</p> } else { <select asp-for="LessonId"><option value="">Choose the lesson that teaches this topic</option>@foreach (var lesson in Model.Lessons) { <option value="@lesson.Id">@lesson.Label</option> }</select> }<span asp-validation-for="LessonId"></span>
<label asp-for="Prompt"></label><textarea asp-for="Prompt" rows="4"></textarea><span asp-validation-for="Prompt"></span>
<div class="choice-editor-grid"><div><label asp-for="ChoiceA"></label><input asp-for="ChoiceA" /></div><div><label asp-for="ChoiceB"></label><input asp-for="ChoiceB" /></div><div><label asp-for="ChoiceC"></label><input asp-for="ChoiceC" /></div><div><label asp-for="ChoiceD"></label><input asp-for="ChoiceD" /></div></div><span asp-validation-for="ChoiceA"></span>
<label asp-for="CorrectChoiceIndex"></label><select asp-for="CorrectChoiceIndex"><option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option></select>
<label asp-for="Explanation"></label><textarea asp-for="Explanation" rows="4" placeholder="Explain why the correct answer is right."></textarea><span asp-validation-for="Explanation"></span>
<label class="check-row"><input asp-for="IsActive" /> <span>Active question</span></label><div class="button-row"><button class="button" type="submit">Save question</button><a class="button secondary" asp-area="Admin" asp-controller="Assessments" asp-action="Details" asp-route-id="@Model.AssessmentId">Cancel</a></div></form></section>
