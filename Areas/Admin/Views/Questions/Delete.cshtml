@model CPE_Review_Hub.ViewModels.QuestionAdminRow
@{ ViewData["Title"] = "Remove question"; }
<span class="eyebrow">ASSESSMENT MANAGEMENT</span><h1>Remove this question?</h1><section class="panel"><h2>@Model.Prompt</h2><p><strong>Correct answer:</strong> @Model.CorrectAnswer</p><p class="muted">Past attempt records will be preserved. The assessment becomes a draft when it no longer contains the required number of active questions.</p><form method="post"><input type="hidden" name="assessmentId" value="@ViewData["AssessmentId"]" /><div class="button-row"><button class="button danger" type="submit">Remove question</button><a class="button secondary" asp-area="Admin" asp-controller="Assessments" asp-action="Details" asp-route-id="@ViewData["AssessmentId"]">Cancel</a></div></form></section>
