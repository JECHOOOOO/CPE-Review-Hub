@model LessonImage
@{ ViewData["Title"] = "Remove lesson image"; }
<span class="eyebrow">CONTENT MANAGEMENT</span><h1>Remove lesson image</h1><section class="panel form-panel"><p>Remove the image record for <strong>@Model.Lesson.Subject.Code · @Model.Lesson.Title</strong>?</p><img class="lesson-image-preview" src="@Model.ImagePath" alt="@Model.AltText" /><p class="muted">The shared local asset file will be kept so another lesson record is not accidentally broken.</p><form method="post"><button class="button danger" type="submit">Remove image</button> <a class="button secondary" asp-action="Index">Cancel</a></form></section>
