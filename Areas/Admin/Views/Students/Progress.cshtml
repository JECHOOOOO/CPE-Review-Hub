@model CPE_Review_Hub.ViewModels.AdminStudentProgressViewModel
@{ ViewData["Title"] = "Student progress"; }
<span class="eyebrow">STUDENT PROGRESSION</span><h1>@Model.StudentName</h1><p class="lead">@Model.StudentEmail · Server-derived activity and passing-quiz status.</p>
<div class="progression-list">@foreach (var course in Model.Courses) { <details class="panel progress-course"><summary><span><strong>@course.Code</strong> — @course.Title</span><span>@course.CompletionPercentage%</span></summary><div class="progress-track"><span style="width:@course.CompletionPercentage%"></span></div><div class="table-scroll"><table><thead><tr><th>Lesson</th><th>Activity</th><th>Quiz</th><th>Best score</th><th>Access</th></tr></thead><tbody>@foreach (var lesson in course.Lessons) { <tr><td>@lesson.Number. @lesson.Title</td><td>@if (lesson.ActivitySubmissionId.HasValue) { <a asp-area="Admin" asp-controller="ActivitySubmissions" asp-action="Details" asp-route-id="@lesson.ActivitySubmissionId">View submission</a> } else { <span>Pending</span> }</td><td>@(lesson.QuizPassed ? "Passed" : "Not passed")</td><td>@(lesson.BestScore.HasValue ? lesson.BestScore.Value.ToString("0.#") + "%" : "—")</td><td>@(lesson.IsCompleted ? "Completed" : lesson.IsUnlocked ? "Available" : "Locked")</td></tr> }</tbody></table></div><p class="small muted">Final exam: @(course.FinalExamUnlocked ? "Unlocked" : "Locked until all six lessons are complete")</p></details> }</div>
