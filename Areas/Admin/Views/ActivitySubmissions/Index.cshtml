@model CPE_Review_Hub.ViewModels.ActivitySubmissionIndexViewModel
@{ ViewData["Title"] = "Activity submissions"; }
<span class="eyebrow">STUDENT WORK</span><h1>Activity submissions</h1><p class="lead">Review written answers, open attachments, and give students grades and useful feedback.</p>
<form method="get" class="filter-row">
    <label class="submission-search">Search students or courses<input name="search" value="@Model.Search" maxlength="120" placeholder="Student name, email, or course code" /></label>
    <label>Status<select name="status"><option value="pending" selected="@(Model.Status == "pending")">Awaiting review</option><option value="graded" selected="@(Model.Status == "graded")">Graded</option><option value="all" selected="@(Model.Status == "all")">All submissions</option></select></label>
    <button class="button" type="submit">Apply filters</button>
</form>
@if (Model.Submissions.Count == 0) { <section class="panel empty-state"><h2>No matching submissions</h2><p>Student activities will appear here after submission.</p></section> }
else
{
    <section class="panel table-scroll"><table><thead><tr><th>Student</th><th>Course / lesson</th><th>Updated</th><th>Files</th><th>Grade</th><th>Review</th></tr></thead><tbody>
    @foreach (var submission in Model.Submissions)
    {
        <tr><td><strong>@submission.StudentName</strong><br /><span class="small muted">@submission.StudentEmail</span></td><td><strong>@submission.SubjectCode</strong><br />@submission.LessonTitle</td><td>@submission.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td>@submission.AttachmentCount</td><td>@(submission.Grade.HasValue ? submission.Grade.Value.ToString("0.##") + " / 100" : "Awaiting review")</td><td><a asp-action="Details" asp-route-id="@submission.Id">Review submission →</a></td></tr>
    }
    </tbody></table></section>
}
<nav class="button-row" aria-label="Submission pages">
    @if (Model.Page > 1) { <a class="button secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search">Previous</a> }
    <span>Page @Model.Page</span>
    @if (Model.HasNextPage) { <a class="button secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search">Next</a> }
</nav>
