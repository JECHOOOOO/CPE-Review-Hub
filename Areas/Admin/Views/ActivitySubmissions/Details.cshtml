@model CPE_Review_Hub.ViewModels.AdminActivitySubmissionViewModel
@{ ViewData["Title"] = "Activity submission"; }
<a asp-action="Index">← Activity submissions</a>
<div class="page-heading"><div><span class="eyebrow">@Model.SubjectCode · @Model.LessonTitle</span><h1>@Model.StudentName</h1><p class="lead">@Model.StudentEmail</p></div><span class="badge">@(Model.GradedAtUtc.HasValue ? "Graded" : "Awaiting review")</span></div>
<p class="small muted">Submitted @Model.CompletedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt") · Updated @Model.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
<div class="submission-review-grid">
    <section class="panel">
        <h2>@Model.ActivityTitle</h2>
        <details><summary>Activity instructions and expected output</summary><div class="material-content">@Model.Instructions</div><strong>Expected output</strong><div class="material-content">@Model.ExpectedOutput</div></details>
        <h3>Student response</h3><div class="submission-response">@Model.Response</div>
        <h3>Submitted files</h3>
        @if (Model.Attachments.Count == 0) { <p class="muted">No files attached.</p> }
        @foreach (var file in Model.Attachments)
        {
            <article class="submission-file">
                @if (file.ContentType is "image/png" or "image/jpeg" or "image/webp")
                {
                    <a asp-action="Preview" asp-route-id="@file.Id" target="_blank" rel="noopener"><img class="submission-image" src="@Url.Action("Preview", new { id = file.Id })" alt="Student attachment: @file.FileName" loading="lazy" /></a>
                }
                <div class="attachment-row"><a asp-action="Download" asp-route-id="@file.Id">Download @file.FileName</a><span class="small muted">@((file.FileSize / 1024d).ToString("0.#")) KB</span></div>
            </article>
        }
    </section>
    <section class="panel grading-panel">
        <span class="eyebrow">ADMIN REVIEW</span><h2>Grade this activity</h2><p class="muted">Read the response and attachments, then assign a score from 0 to 100.</p>
        <form asp-action="Grade" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <input asp-for="Grade.Revision" type="hidden" />
            <label asp-for="Grade.Score"></label><input asp-for="Grade.Score" type="number" min="0" max="100" step="0.01" required />
            <label asp-for="Grade.Feedback"></label><textarea asp-for="Grade.Feedback" rows="7" maxlength="4000" placeholder="Explain what went well and what to improve."></textarea>
            <button class="button full" type="submit">Save grade &amp; feedback</button>
        </form>
        @if (Model.GradedAtUtc.HasValue) { <p class="small muted">Last graded by @Model.GraderName on @Model.GradedAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt").</p> }
        <p class="small muted">Changes to the student's response or files return this activity to awaiting review. Quiz access is unchanged.</p>
    </section>
</div>
