@model IReadOnlyList<CPE_Review_Hub.ViewModels.AttemptAdminRow>
@using CPE_Review_Hub.Models
@{ ViewData["Title"] = "Student results"; var subjects = (IReadOnlyList<CPE_Review_Hub.ViewModels.SelectionOption>)ViewBag.Subjects; }
<span class="eyebrow">LEARNING RECORDS</span><h1>Student results</h1><p class="lead">Real submitted quiz and exam attempts from the shared MySQL database.</p>
<section class="panel"><form method="get" class="filter-row"><select name="type"><option value="">All assessment types</option><option value="LessonQuiz" selected="@(ViewData["Type"]?.ToString() == "LessonQuiz")">Lesson quizzes</option><option value="FinalExam" selected="@(ViewData["Type"]?.ToString() == "FinalExam")">Final exams</option></select><select name="subjectId"><option value="">All courses</option>@foreach (var s in subjects) { <option value="@s.Id" selected="@((int?)ViewData["SubjectId"] == s.Id)">@s.Label</option> }</select><button class="button" type="submit">Apply filters</button></form>
@if (Model.Count == 0) { <div class="empty-state"><h2>No submitted attempts</h2></div> } else { <div class="table-scroll"><table><thead><tr><th>Student</th><th>Course</th><th>Assessment</th><th>Attempt</th><th>Score</th><th>Status</th><th>Submitted</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td><strong>@row.StudentName</strong><br /><span class="small muted">@row.StudentEmail</span></td><td>@row.SubjectCode</td><td><a asp-action="Details" asp-route-id="@row.Id">@row.AssessmentTitle</a></td><td>#@row.AttemptNumber</td><td>@row.Score/@row.Total (@row.Percentage.ToString("0.#")%)</td><td><span class="badge">@(row.IsPassed ? "Passed" : "Needs review")</span></td><td>@row.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td></tr> }</tbody></table></div> }</section>
