@model CPE_Review_Hub.ViewModels.AdminStatisticsViewModel
@{ ViewData["Title"] = "Statistics"; }
<span class="eyebrow">SYSTEM INSIGHTS</span><h1>Learning statistics</h1><p class="lead">Computed from actual students, submitted activities, quizzes, and final exams.</p>
<section class="metric-grid"><article class="metric-card"><span>Students</span><strong>@Model.StudentCount</strong></article><article class="metric-card"><span>Quiz attempts</span><strong>@Model.QuizAttempts</strong><small>Average @Model.AverageQuizScore.ToString("0.#")%</small></article><article class="metric-card"><span>Exam attempts</span><strong>@Model.ExamAttempts</strong><small>Average @Model.AverageExamScore.ToString("0.#")%</small></article><article class="metric-card"><span>Lesson completion</span><strong>@Model.LessonCompletionRate.ToString("0.#")%</strong><small>@Model.PassedAttempts passed · @Model.FailedAttempts failed attempts</small></article></section>
<section class="panel"><h2>Course performance</h2><div class="table-scroll"><table><thead><tr><th>Course</th><th>Quiz attempts</th><th>Exam attempts</th><th>Average</th><th>Students completing 6 lessons</th><th>Completion rate</th></tr></thead><tbody>@foreach (var row in Model.Courses) { <tr><td><strong>@row.Code</strong><br /><span class="small muted">@row.Title</span></td><td>@row.QuizAttempts</td><td>@row.ExamAttempts</td><td>@row.AverageScore.ToString("0.#")%</td><td>@row.CompletedStudents</td><td>@row.CompletionRate.ToString("0.#")%</td></tr> }</tbody></table></div></section>
