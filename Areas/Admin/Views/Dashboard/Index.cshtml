@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin dashboard"; }
<span class="eyebrow">ADMIN DASHBOARD</span><h1>Welcome, @Model.FullName.</h1><p class="lead">Keep your student community organized and supported.</p>
<div class="stats-grid"><a asp-area="Admin" asp-controller="Students" asp-action="Index"><span>Students</span><strong>@Model.StudentCount</strong></a><a asp-area="Admin" asp-controller="Subjects" asp-action="Index"><span>Subjects</span><strong>@Model.SubjectCount</strong></a><a asp-area="Admin" asp-controller="Lessons" asp-action="Index"><span>Lessons</span><strong>@Model.LessonCount</strong></a><a asp-area="Admin" asp-controller="Materials" asp-action="Index"><span>Materials</span><strong>@Model.MaterialCount</strong></a></div>
<div class="section-heading"><h2>Content management</h2><span class="muted small">Shared MySQL content library</span></div>
<div class="feature-grid"><article class="feature-card"><h3>Subjects</h3><p>Add CPE subjects under the 200, 300, and 400 levels.</p><a asp-area="Admin" asp-controller="Subjects" asp-action="Index">Manage subjects →</a></article><article class="feature-card"><h3>Lessons &amp; materials</h3><p>Build lessons and publish plain-text review content.</p><a asp-area="Admin" asp-controller="Lessons" asp-action="Index">Manage lessons →</a></article><article class="feature-card"><h3>Assessments</h3><p>Question banks, quizzes, exams, and statistics are the next phase.</p><span class="status-label">Planned</span></article></div>
