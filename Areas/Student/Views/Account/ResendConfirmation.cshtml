@model ResendConfirmationViewModel
@{ Layout = "_SiteLayout"; ViewData["Title"] = "Resend verification email"; }
<section class="auth-card standalone"><span class="eyebrow">STUDENT ACCOUNT</span><h1>Resend verification email</h1><p>Enter the email used for student registration.</p><form method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" required /><button class="button full" type="submit">Send verification link</button></form><p class="form-foot"><a href="/student.html">Back to student login</a></p></section>
