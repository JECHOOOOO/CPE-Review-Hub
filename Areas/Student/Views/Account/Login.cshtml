@model LoginViewModel
@{ Layout = "_SiteLayout"; ViewData["Title"] = "Student login"; ViewData["BodyClass"] = "auth-page student-auth-page login-page"; }
<div class="auth-grid">
    <section class="auth-intro"><span class="eyebrow">STUDENT PORTAL</span><h1>Your next step<br />starts here.</h1><p>A dedicated space for your Computer Engineering review journey.</p><div class="intro-note"><strong>One place for your learning</strong><p>Your own account, profile, and student workspace.</p></div></section>
    <section class="auth-card"><span class="badge">For students</span><h2>Welcome back</h2><p>Sign in with your student account.</p>
        <form action="/student.html" method="post" asp-antiforgery="true">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label asp-for="Email"></label><input asp-for="Email" autocomplete="username" placeholder="you@university.edu" required />
            <label asp-for="Password"></label><div class="password-field"><input asp-for="Password" autocomplete="current-password" required /><button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div>
            <p class="forgot-link"><a href="/student/forgot-password">Forgot Password?</a></p>
            <button type="submit" class="button full">Sign in to student portal →</button>
        </form>
        <p class="form-foot">New here? <a asp-area="Student" asp-controller="Account" asp-action="Register">Create a student account</a></p>
        <p class="form-foot about-form-link"><a href="/about">About COLMS</a></p>
    </section>
</div>
