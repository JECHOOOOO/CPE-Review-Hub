@model StudentSubjectIndexViewModel
@{ ViewData["Title"] = "Subjects"; }
<span class="eyebrow">LEARNING LIBRARY</span><h1>Choose your subjects</h1><p class="lead">Browse published lessons and review materials by academic level.</p>
<nav class="filter-pills" aria-label="Academic level filter"><a class="@(Model.SelectedLevel is null ? "active" : "")" asp-action="Index">All levels</a>@foreach (var level in Model.Levels) { <a class="@(Model.SelectedLevel == level.Id ? "active" : "")" asp-action="Index" asp-route-level="@level.Id">@level.Label</a> }</nav>
@if (Model.Subjects.Count == 0) { <section class="panel empty-state"><h2>No published subjects yet</h2><p>Your administrator is still preparing content for this level.</p></section> }
else {
    @foreach (var level in Model.Levels.Where(x => Model.SelectedLevel is null || x.Id == Model.SelectedLevel)) {
        var courses = Model.Subjects.Where(x => x.Level == level.Label).ToList();
        if (courses.Count == 0) { continue; }
        <section class="course-level-section"><div class="section-heading"><h2>@level.Label</h2><span class="muted small">@courses.Count course(s)</span></div>
            <div class="subject-grid">@foreach (var subject in courses) { <article class="subject-card"><div><span class="eyebrow">@subject.Level</span><h2>@subject.Code</h2><h3>@subject.Title</h3><p>@subject.Description</p></div><div class="card-footer"><span>@subject.LessonCount lesson(s)</span><a class="button secondary" asp-action="Details" asp-route-id="@subject.Id">Open course →</a></div></article> }</div>
        </section>
    }
}
