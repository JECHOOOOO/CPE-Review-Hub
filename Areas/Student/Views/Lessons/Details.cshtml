@model StudentLessonDetailsViewModel
@{ ViewData["Title"] = Model.Title; }
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-area="Student" asp-controller="Subjects" asp-action="Index">Subjects</a><span>/</span><a asp-area="Student" asp-controller="Subjects" asp-action="Details" asp-route-id="@Model.SubjectId">@Model.SubjectCode</a><span>/</span><span>@Model.Title</span></nav>
<span class="eyebrow">@Model.SubjectCode · LESSON</span><h1>@Model.Title</h1><p class="lead">@Model.Summary</p>
@if (Model.Materials.Count == 0) { <section class="panel empty-state"><h2>No published materials yet</h2><p>The lesson outline is available, but its review material is still being prepared.</p></section> }
else { var lessonImageIndex = 0; <div class="material-stack">@foreach (var material in Model.Materials) {
    var sections = material.Content.Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    <article class="panel material-card"><h2>@material.Title</h2>
        @for (var sectionIndex = 0; sectionIndex < sections.Length; sectionIndex++) {
            <div class="material-content lesson-section">@sections[sectionIndex]</div>
            @if (sectionIndex >= 2 && lessonImageIndex < Model.Images.Count) {
                var lessonImage = Model.Images[lessonImageIndex++];
                <figure class="lesson-figure"><img src="@lessonImage.ImagePath" alt="@lessonImage.AltText" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('figure').hidden=true" />
                    @if (!string.IsNullOrWhiteSpace(lessonImage.Caption)) { <figcaption>@lessonImage.Caption</figcaption> }
                    @if (!string.IsNullOrWhiteSpace(lessonImage.SourceUrl)) { <small class="lesson-image-credit">Source: <a href="@lessonImage.SourceUrl" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(lessonImage.SourceName) ? "Image source" : lessonImage.SourceName)</a>@if (!string.IsNullOrWhiteSpace(lessonImage.Author)) { <text> · @lessonImage.Author</text> }@if (!string.IsNullOrWhiteSpace(lessonImage.License)) { <text> · @lessonImage.License</text> }</small> }
                </figure>
            }
        }
        @if (material == Model.Materials.Last()) { @while (lessonImageIndex < Model.Images.Count) { var lessonImage = Model.Images[lessonImageIndex++]; <figure class="lesson-figure"><img src="@lessonImage.ImagePath" alt="@lessonImage.AltText" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('figure').hidden=true" />@if (!string.IsNullOrWhiteSpace(lessonImage.Caption)) { <figcaption>@lessonImage.Caption</figcaption> }@if (!string.IsNullOrWhiteSpace(lessonImage.SourceUrl)) { <small class="lesson-image-credit">Source: <a href="@lessonImage.SourceUrl" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(lessonImage.SourceName) ? "Image source" : lessonImage.SourceName)</a>@if (!string.IsNullOrWhiteSpace(lessonImage.Author)) { <text> · @lessonImage.Author</text> }@if (!string.IsNullOrWhiteSpace(lessonImage.License)) { <text> · @lessonImage.License</text> }</small> }</figure> } }
        @if (!string.IsNullOrWhiteSpace(material.ResourceUrl)) { <p><a class="button secondary" href="@material.ResourceUrl" target="_blank" rel="noopener noreferrer">Open supporting resource ↗</a></p> }
    </article> }</div> }
@if (Model.Activity is not null) {
    <section class="panel activity-card"><span class="eyebrow">REQUIRED BEFORE QUIZ</span><h2>@Model.Activity.Title</h2>
        <div class="material-content">@Model.Activity.Instructions</div>
        @if (Model.Activity.IsCompleted)
        {
            <div class="activity-grade" role="status"><strong>Activity completed.</strong></div>
        }
        <form asp-area="Student" asp-controller="Activities" asp-action="Submit" asp-route-id="@Model.Activity.Id" method="post" enctype="multipart/form-data" class="activity-form">
            @if (Model.Activity.ResponseType == ActivityResponseType.MultipleChoice) {
                <fieldset class="activity-options"><legend>Select your answer</legend>@foreach (var option in Model.Activity.Options) { <label class="activity-option"><input type="radio" name="Response" value="@option" checked="@(Model.Activity.Response == option)" required /> <span>@option</span></label> }</fieldset>
            } else if (Model.Activity.ResponseType == ActivityResponseType.Matching) {
                <div class="matching-grid"><p class="muted">Choose a description for every term.</p>@for (var matchIndex = 0; matchIndex < Model.Activity.Matches.Count; matchIndex++) { var match = Model.Activity.Matches[matchIndex]; <label><strong>@match.Term</strong><select name="MatchingResponses[@matchIndex]" required><option value="">Select description</option>@foreach (var choice in Model.Activity.Matches.Select(x => x.Definition)) { <option value="@choice" selected="@(Model.Activity.Response.Contains($"{match.Term} → {choice}", StringComparison.Ordinal))">@choice</option> }</select></label> }</div>
            } else if (Model.Activity.ResponseType is ActivityResponseType.Calculation or ActivityResponseType.Identification) {
                <label for="Response">Your answer</label><input id="Response" name="Response" value="@Model.Activity.Response" maxlength="10000" required />
            } else {
                <label for="Response">@(Model.Activity.ResponseType == ActivityResponseType.Coding ? "Your code or explanation" : "Your response")</label>
                <textarea id="Response" name="Response" rows="@(Model.Activity.ResponseType == ActivityResponseType.Coding ? 12 : 6)" maxlength="10000">@Model.Activity.Response</textarea>
            }
            <div class="attachment-picker"><label for="Attachments">Attach files or images <span class="muted">(optional)</span></label><input id="Attachments" name="Attachments" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.pdf,.docx,.txt" /><p class="small muted">Up to 3 files · 5 MB each · 10 MB total. PNG, JPG, WEBP, PDF, DOCX, or TXT.</p></div>
            <div class="form-actions"><button class="button" type="submit">@(Model.Activity.IsCompleted ? "Update activity" : "Submit activity and unlock quiz")</button>
                @if (Model.Activity.IsCompleted) { <span class="status-complete">Completed @Model.Activity.CompletedAtUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span> }
            </div>
        </form>
        @if (Model.Activity.Attachments.Count > 0) { <div class="attachment-list"><h3>Submitted attachments</h3>@foreach (var file in Model.Activity.Attachments) { <div class="attachment-row"><a asp-area="Student" asp-controller="Activities" asp-action="Download" asp-route-id="@file.Id">@file.FileName</a><span class="small muted">@((file.FileSize / 1024d).ToString("0.#")) KB</span><form asp-area="Student" asp-controller="Activities" asp-action="DeleteAttachment" asp-route-id="@file.Id" method="post"><button class="danger-link" type="submit">Remove</button></form></div> }</div> }
    </section>
}
@if (Model.Quiz is not null) {
    <section class="panel assessment-status" id="quiz"><div><span class="eyebrow">LESSON CHECK</span><h2>10-item lesson quiz</h2>
        <p>@(Model.Quiz.IsUnlocked ? "Your activity is complete. You may take the quiz." : "Submit the required activity above before attempting this quiz.")</p>
        @if (Model.Quiz.BestPercentage is not null) { <p><strong>Best score: @Model.Quiz.BestPercentage.Value.ToString("0.##")%</strong> from @Model.Quiz.AttemptCount attempt(s)</p> }
    </div><div><strong>@Model.Quiz.CurrentQuestions / @Model.Quiz.RequiredQuestions</strong><span>@(Model.Quiz.IsReady ? "Questions ready" : "Questions being prepared")</span>
        @if (Model.Quiz.IsReady && Model.Quiz.IsUnlocked) { <form asp-area="Student" asp-controller="Assessments" asp-action="Start" asp-route-id="@Model.Quiz.Id" method="post"><button class="button" type="submit">@(Model.Quiz.AttemptCount > 0 ? "Retake quiz" : "Start quiz") →</button></form> }
        else if (!Model.Quiz.IsUnlocked) { <span class="badge">Locked</span> }
    </div></section>
}
