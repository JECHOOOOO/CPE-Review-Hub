@model StudentLessonImageViewModel
<figure class="lesson-figure">
    <img src="@Model.ImagePath" alt="@Model.AltText" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.closest('figure').hidden=true" />
    @if (!string.IsNullOrWhiteSpace(Model.Caption)) { <figcaption>@Model.Caption</figcaption> }
    @if (!string.IsNullOrWhiteSpace(Model.SourceUrl)) {
        <small class="lesson-image-credit">Source: <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(Model.SourceName) ? "Image source" : Model.SourceName)</a>@if (!string.IsNullOrWhiteSpace(Model.Author)) { <text> · @Model.Author</text> }@if (!string.IsNullOrWhiteSpace(Model.License)) { <text> · @Model.License</text> }</small>
    }
</figure>
